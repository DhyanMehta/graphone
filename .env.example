# GitHub personal access token for API calls (higher rate limits)
GITHUB_TOKEN=ghp_your_token_here

# Phase III: LLM Provider Keys (Multi-Tier Fallback Chain: Groq -> Gemini -> OpenRouter)
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Phase V: Google Sheets Export Credentials
# Path to service account json file (default looks for ./service_account.json)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Or provide inline JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
